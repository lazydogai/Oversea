# Copy to `.env` for local development.

APP_ENV=development
APP_NAME=oversea-amazon-mvp
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/oversea
REDIS_URL=redis://localhost:6379/0

SECRET_KEY=replace-with-local-secret
TOKEN_ENCRYPTION_KEY=replace-with-32-byte-key

LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

APIFY_TOKEN=
APIFY_AMAZON_SEARCH_ACTOR=

AMAZON_APP_ID=
AMAZON_CLIENT_SECRET=
AMAZON_REFRESH_TOKEN=
AMAZON_REGION=NA
AMAZON_MARKETPLACE_ID=ATVPDKIKX0DER
AMAZON_SELLER_ID=
APIFY_API_TOKEN=
APIFY_AMAZON_SCRAPER_ACTOR_ID=
DEBUG_MODE=True
USE_LIVE_APIFY=False
APIFY_TIMEOUT_SECONDS=240
APIFY_SNAPSHOT_FALLBACK=False
APIFY_SNAPSHOT_KEYWORD=desk lamp

CREDIT_SEARCH_TOP200=10
CREDIT_DEEP_DIVE_TOP20=30
CACHE_REPORT_TTL_SECONDS=86400
